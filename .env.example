# Copy this file to .env and set real values. .env is git-ignored: never commit it.
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=change-me

# Used by scripts and ingestion. After Jenkins starts, create a token at
# http://localhost:8080/user/admin/security (API Token > Add new Token) and paste it here.
JENKINS_URL=http://localhost:8080
JENKINS_API_TOKEN=
